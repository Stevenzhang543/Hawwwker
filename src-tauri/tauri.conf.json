{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hawwwker",
  "version": "26.1.0",
  "identifier": "com.hawwwker.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hawwwker 货客",
        "width": 1360,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "windowEffects": { "effects": ["mica"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "AI 多平台购物搜索、比价与盯价",
    "longDescription": "Hawwwker 货客：在你登录好的各个购物平台上，用 AI 替你搜索、比价、盯价。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }
    }
  }
}
